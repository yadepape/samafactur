    {
      "src": "screenshots/desktop-dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tableau de bord SamaFacture"
    },
    {
      "src": "screenshots/mobile-dashboard.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tableau de bord mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouvelle Facture",
      "short_name": "Facture",
      "description": "Créer une nouvelle facture rapidement",
      "url": "/?action=new-invoice",
      "icons": [
        {
          "src": "icons/shortcut-invoice.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nouveau Client",
      "short_name": "Client",
      "description": "Ajouter un nouveau client",
      "url": "/?action=new-client",
      "icons": [
        {
          "src": "icons/shortcut-client.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nouveau Produit",
      "short_name": "Produit",
      "description": "Ajouter un nouveau produit",
      "url": "/?action=new-product",
      "icons": [
        {
          "src": "icons/shortcut-product.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tableau de Bord",
      "short_name": "Dashboard",
      "description": "Voir les statistiques et le tableau de bord",
      "url": "/?action=dashboard",
      "icons": [
        {
          "src": "icons/shortcut-dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+samafacture",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls", ".xlsx"]
      }
    }
  ]
}
