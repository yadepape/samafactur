{
  "name": "samafacture",
  "version": "1.0.0",
  "description": "Système complet de gestion de facturation pour les TPE sénégalaises",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:electron\"",
    "dev:web": "webpack serve --mode development --config webpack.config.js",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "webpack --mode production && electron-builder",
    "build:web": "webpack --mode production",
    "build:electron": "electron-builder",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "facturation",
    "senegal",
    "tpe",
    "electron",
    "pwa",
    "gestion"
  ],
  "author": "SamaFacture Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "file-loader": "^6.2.0",
    "copy-webpack-plugin": "^11.0.0"
  },
  "dependencies": {
    "sql.js": "^1.8.0",
    "chart.js": "^4.4.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.6.0",
    "xlsx": "^0.18.5",
    "crypto-js": "^4.2.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0"
  },
  "build": {
    "appId": "com.samafacture.app",
    "productName": "SamaFacture",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

